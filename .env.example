# Vouch — environment variable NAMES with placeholder values only.
# Copy to `.env` (root, gitignored) and fill in. NEVER commit real values.
# Source of truth for meanings: AGENTS/INTERFACES.md §7.

# --- Network (Arc Testnet) — verified, D-101 ---
# Public canonical RPC shown; replace with your keyed QuickNode endpoint if you have one.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io

# --- Tokens / contracts ---
USDC_ADDRESS=0x3600000000000000000000000000000000000000
VOUCH_CONTRACT_ADDRESS=0xF4B641dc628de05336aa983B07D5d181254ff08e
VOUCH_DEPLOY_BLOCK=72605845
HELLO_ADDRESS=0x0000000000000000000000000000000000000000

# --- Keys (0x-prefixed 32-byte hex). Orchestrator generates; never paste real keys here. ---
DEPLOYER_PRIVATE_KEY=0x__deployer_key__
RELAYER_PRIVATE_KEY=0x__relayer_key__
ATTRIBUTOR_PRIVATE_KEY=0x__attributor_key__
VENUE_SIGNER_PRIVATE_KEY=0x__venue_signer_key__
# Spike only (S5): a throwaway "customer" key
SPIKE_USER_PRIVATE_KEY=0x__spike_user_key__

# --- QuickNode Streams ---
QUICKNODE_STREAMS_API_KEY=__quicknode_api_key__
STREAMS_WEBHOOK_SECRET=__streams_webhook_secret__

# --- Backend ---
# postgres://user:pass@host:5432/db for hosted Postgres; pglite://./data/local/pglite (or empty) for local embedded PGlite
DATABASE_URL=pglite://./data/local/pglite
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=__session_secret__
# Session lifetime (seconds, default 7 days) and the web origin used to build intro-link / QR URLs
SESSION_TTL_SECONDS=604800
PUBLIC_WEB_URL=http://localhost:3100
# Relayer guards (BACKEND_RELAYER, D-801). Defaults shown; all optional.
RELAYER_MAX_GAS_PAY=1200000
RELAYER_MAX_FEE_GWEI=200
RELAYER_RECEIPT_TIMEOUT_MS=30000
RELAYER_MAX_SEND_ATTEMPTS=4
RELAYER_RATE_PER_USER_PER_MIN=12
RELAYER_RATE_GLOBAL_PER_MIN=120
RELAYER_MAX_QUEUE=50
# story:api CLI target (default http://localhost:4010)
STORY_API_URL=http://localhost:4010

# --- Frontend (exposed to browser) ---
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Attribution AI (optional, Tier 3) ---
LLM_PROVIDER=none
LLM_API_KEY=__llm_api_key__

# --- Demo personas (CLI/seed scripts; generated by scripts/setup/gen-env.py) ---
DEMO_LENA_PRIVATE_KEY=0x__demo_lena_key__
DEMO_ANA_PRIVATE_KEY=0x__demo_ana_key__
DEMO_BEN_PRIVATE_KEY=0x__demo_ben_key__
DEMO_PRIYA_PRIVATE_KEY=0x__demo_priya_key__
