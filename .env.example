# RELAYER_BUDGET_DAILY_USDC=5.00
# RELAYER_BUDGET_USER_HOURLY_USDC=0.20
# RELAYER_BUDGET_USER_DAILY_USDC=0.50
# RELAYER_BUDGET_VENUE_HOURLY_USDC=0.50
# RELAYER_BUDGET_VENUE_DAILY_USDC=2.00
# RELAYER_MIN_BALANCE_USDC=2.00
# ORDER_MIN_USDC=0.50
# RELAYER_PAY_RESERVE=20
# RELAYER_QUOTA_REGISTER_PER_DAY=3
# RELAYER_QUOTA_OWNER_ACTIONS_PER_HOUR=20
# RELAYER_QUOTA_ACCEPTS_PER_HOUR=20
# RELAYER_QUOTA_PAYS_PER_HOUR=30
# RATE_AUTH_PER_MIN=20
# RATE_SPEND_PER_MIN=20
# RATE_WRITE_PER_MIN=60
# RATE_READ_PER_MIN=300
# RATE_SSE_PER_MIN=20
# SSE_MAX_CONNECTIONS=500
# SSE_MAX_PER_IP=8
# SSE_MAX_PER_CHANNEL=100
# SSE_MAX_AGE_MS=1800000
# SSE_HEARTBEAT_MS=15000
# SSE_MAX_BUFFERED_BYTES=262144
# TRUST_PROXY=100.64.0.0/10   # off | <hop count> | CIDR list

# --- Phase 3 demo top-up (D-811); all optional, off by default ---
# DEMO_TOPUP_ENABLED=true
# DEMO_TOPUP_USDC=3.00
# DEMO_TOPUP_DAILY_USDC=30.00
# DEMO_TOPUP_PER_IP_PER_HOUR=5
# DEMO_TOPUP_FUNDER_FLOOR_USDC=5.00
# TOPUP_PRIVATE_KEY=            # secret; unset = relayer key funds top-ups
