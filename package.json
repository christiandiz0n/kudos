{
  "name": "wom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* run build",
    "test": "pnpm -r --if-present run test && pnpm run test:contracts",
    "test:contracts": "cd contracts && forge test",
    "build:contracts": "cd contracts && forge build",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @wom/api dev",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "spike:s5:local": "bash scripts/spikes/s5-local.sh"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "typescript": "^5.9.3"
  }
}
