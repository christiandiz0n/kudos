{
  "name": "@vouch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test 'src/**/*.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:generate:streams": "drizzle-kit generate --config drizzle-streams.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fastify/cors": "11.4.3",
    "@vouch/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "viem": "2.57.18"
  },
  "devDependencies": {
    "@types/node": "^24",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.9.3"
  }
}
